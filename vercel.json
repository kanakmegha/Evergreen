{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web"
    },
    "api": {
      "root": ".",
      "framework": "go",
      "buildCommand": "go build -o server ./cmd/api"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/internal/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/healthz",
      "destination": { "service": "api" }
    },
    {
      "source": "/readyz",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}
