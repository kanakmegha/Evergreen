# Local development only. Replace secrets and restrict network exposure before deployment.
DATABASE_URL=postgres://everroot@127.0.0.1:54330/everroot?sslmode=disable
# For Neon hosted database (use pooled endpoint for DATABASE_URL, direct endpoint for DIRECT_URL):
# DATABASE_URL=postgres://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
# DIRECT_URL=postgres://[user]:[password]@[endpoint].[region].aws.neon.tech/[dbname]?sslmode=require
# DIRECT_URL is the unpooled endpoint and is read only by `go run ./cmd/migrate`.
# The server never uses it. A Neon database that has never been migrated answers
# Ping successfully but has no tables; `go run ./cmd/dbcheck` reports that as
# category=schema_missing.
DIRECT_URL=
DATABASE_MAX_CONNS=10
# Bound on one connection attempt. pgxpool's own default is two minutes, which
# is longer than any request this API serves. Raise it only if Neon cold starts
# exceed it.
DATABASE_CONNECT_TIMEOUT=10s
# Local development only. A platform that provides PORT (Vercel, Render, Fly)
# assigns the port itself and probes it, and PORT takes precedence over this
# value. Never set API_ADDR on such a platform: the server would bind the wrong
# port and the deployment would be reported as "did not start listening".
API_ADDR=127.0.0.1:8080
ADMIN_LOCAL_ENABLED=true
ADMIN_REVIEWER_ID=local-reviewer
ADMIN_REVIEWER_ROLE=cultural
WEB_ORIGIN=http://localhost:5173
# Exact, comma-separated allow-list for cross-origin calls to this API. A
# missing value grants nothing and there is no wildcard, because this API spends
# a paid model call on /api/v1/questions. Only needed when the web app is on a
# different origin; the normal deployment serves both from one origin.
# PUBLIC_SITE_URL is the web app's own public origin. Leave unset for local
# development: canonical links, robots.txt and sitemap.xml then use the origin
# the request arrived on. Set it before launch, e.g. https://example.org
PUBLIC_SITE_URL=
# The backend origin, e.g. https://everroot-api.example. Prefer this for a split
# deployment: the web app and the API are separate Vercel projects, so the API is
# not reachable on the web app's own origin. Read through SvelteKit's
# `$env/static/public`, so it is inlined when the web app is built and changing
# it needs a new deployment. If you set it, also set WEB_ORIGIN on the API to the
# web app's origin, because a split origin needs CORS.
PUBLIC_API_URL=
# Set to `true` only when the API is served from the SAME origin as the web app
# (the root vercel.json Services deployment). Development needs neither: the dev
# server proxies /api and same-origin is allowed automatically. A production
# build with neither set refuses to send catalogue requests and reports a
# configuration error, instead of quietly calling the web app's own origin and
# getting an HTML 404.
PUBLIC_API_SAME_ORIGIN=
HF_TOKEN=your-hugging-face-token
# Leave unset to use the default (openai/gpt-oss-120b), which lets the router
# fail over across providers. A policy suffix such as :cheapest pins a single
# provider: it is cheaper, but that provider being busy becomes a 429
# ("engine_overloaded") for every visitor. A pinned value is still retried with
# failover, but the un-pinned default is the more reliable choice.
# HF_MODEL_ID=openai/gpt-oss-120b:cheapest
HF_BASE_URL=https://router.huggingface.co/v1
# Research behind POST /api/v1/discovery, which retrieves sources before the
# model call. Unset or empty means research is off and every discovery is
# honestly labelled researchStatus="unavailable". Recognised values: "none"
# (explicitly off), "open-web" (Wikipedia plus GBIF; needs no API key at all),
# "search-api" (a general web search service over RESEARCH_API_URL and
# RESEARCH_API_KEY), or a comma-separated list such as "open-web,search-api"
# to fan out across both at once. An unrecognised value is logged as a warning
# and treated as research off, rather than refusing to start the server.
RESEARCH_PROVIDER=
# Endpoint the "search-api" backend POSTs its query to. Required whenever
# RESEARCH_PROVIDER names search-api; without it the server logs a warning and
# discoveries run un-researched. The adapter auto-detects which response shape
# it received and understands three: a Tavily-style
# {"results":[{"title":..,"url":..,"content":..}]}, a Brave-style
# {"web":{"results":[{"title":..,"url":..,"description":..}]}} and a
# Serper-style {"organic":[{"title":..,"link":..,"snippet":..}]}. A reply
# matching none of them is reported as an unavailable research backend, never
# as a silent empty result.
RESEARCH_API_URL=
# Optional credential for the "search-api" backend; leave empty when the
# service needs no key. It is sent only in an Authorization header and never
# in the URL, so it cannot surface in a redirect, a proxy log or an error
# string, and it is never logged, echoed or returned by the API. Never commit
# a real key: keep real values in .env (untracked) or in the deployment's own
# environment only.
RESEARCH_API_KEY=
