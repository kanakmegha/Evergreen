# Local development only. Replace secrets and restrict network exposure before deployment.
DATABASE_URL=postgres://everroot@127.0.0.1:54330/everroot?sslmode=disable
# For Neon hosted database (use pooled endpoint for DATABASE_URL, direct endpoint for DIRECT_URL):
# DATABASE_URL=postgres://[user]:[password]@[endpoint]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require
# DIRECT_URL=postgres://[user]:[password]@[endpoint].[region].aws.neon.tech/[dbname]?sslmode=require
DIRECT_URL=
DATABASE_MAX_CONNS=10
API_ADDR=127.0.0.1:8080
ADMIN_LOCAL_ENABLED=true
ADMIN_REVIEWER_ID=local-reviewer
ADMIN_REVIEWER_ROLE=cultural
WEB_ORIGIN=http://localhost:5173
# Public origin of the web app. Leave unset for local development: canonical
# links, robots.txt and sitemap.xml then use the origin the request arrived on.
# Set it before launch to the real domain, e.g. PUBLIC_SITE_URL=https://example.org
PUBLIC_SITE_URL=
# Optional. Only needed when the API is served from a different origin than the
# web app. The normal deployment is same-origin (vercel.json rewrites /api), so
# leave this unset. If you do set it, also set WEB_ORIGIN on the API to the web
# app's origin, because a split origin needs CORS.
PUBLIC_API_URL=
HF_TOKEN=your-hugging-face-token
HF_MODEL_ID=openai/gpt-oss-120b:cheapest
HF_BASE_URL=https://router.huggingface.co/v1
